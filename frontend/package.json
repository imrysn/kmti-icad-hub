{
    "name": "kmti-icad-hub",
    "version": "1.0.1",
    "description": "KMTI iCAD training, assessment, support, and quotation desktop hub",
    "author": "Kusakabe & Maeno Tech., Inc.",
    "main": "electron/main.js",
    "scripts": {
        "dev": "vite --port 5173 --strictPort",
        "typecheck": "tsc --noEmit --incremental false",
        "build": "npm run typecheck && vite build",
        "preview": "vite preview",
        "electron:dev": "concurrently \"vite --port 5173 --strictPort\" \"wait-on tcp:5173 && electron .\"",
        "package": "npm run build && electron-builder",
        "dist": "node build-all.js",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "exceljs": "^4.4.0",
        "file-saver": "^2.0.5",
        "socket.io-client": "^4.8.3"
    },
    "overrides": {
        "uuid": "^11.1.1"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/canvas-confetti": "^1.9.0",
        "@types/file-saver": "^2.0.7",
        "@types/jszip": "^3.4.0",
        "@types/react": "^18.2.15",
        "@types/react-dom": "^18.2.7",
        "@types/three": "^0.182.0",
        "@vitejs/plugin-react": "^6.0.4",
        "@vitest/coverage-v8": "^4.1.8",
        "axios": "^1.4.0",
        "canvas-confetti": "^1.9.4",
        "concurrently": "^8.2.0",
        "electron": "^43.2.0",
        "electron-builder": "^26.15.3",
        "framer-motion": "^12.38.0",
        "jsdom": "^29.1.1",
        "jszip": "^3.10.1",
        "lucide-react": "^0.263.1",
        "msw": "^2.14.6",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-markdown": "^10.1.0",
        "react-router-dom": "^7.13.1",
        "remark-gfm": "^4.0.1",
        "three": "^0.182.0",
        "typescript": "^5.0.2",
        "vite": "^8.1.5",
        "vitest": "^4.1.8",
        "wait-on": "^7.0.1"
    },
    "build": {
        "appId": "com.kmti.icad.hub",
        "productName": "KMTI Training Hub",
        "icon": "src/assets/kmti-training-hub.png",
        "directories": {
            "output": "dist-electron"
        },
        "files": [
            "dist/**/*",
            "electron/**/*",
            "package.json"
        ],
        "asarUnpack": [
            "electron/**/*"
        ],
        "win": {
            "icon": "src/assets/kmti-training-hub.png",
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "portable",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true
        }
    }
}
