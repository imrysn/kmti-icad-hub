# Copy this file to a protected .env beside the backend executable on the
# deployment server. Never commit or include the populated file in artifacts.
ENVIRONMENT=production
APPLICATION_PROFILE=lms
ENFORCE_LMS_DATABASE_ISOLATION=true
USE_MYSQL=true
# For isolated SQLite development profiles, set USE_MYSQL=false and provide
# a unique path such as backend/kmti_lms_dev.db.
SQLITE_DB_PATH=
DB_HOST=replace-with-managed-mysql-host
DB_PORT=3306
DB_NAME=kmti_lms
DB_USER=replace-with-service-account
DB_PASSWORD=replace-with-secret
SERVER_PORT=3002
PUBLIC_APP_URL=https://training.example.jp
EMAIL_DELIVERY_MODE=outbox
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=660
UPLOAD_DIR=replace-with-absolute-upload-directory

# Use an exact comma-separated allowlist in production. Add only origins that
# actually host the approved browser/Electron renderer.
CORS_ORIGINS=https://training.example.jp

# Optional services
GEMINI_MODEL=gemini-2.0-flash
GOOGLE_API_KEY=
TTS_MODEL_DIR=
VECTOR_DB_PATH=
STATIC_ASSETS_PATH=
