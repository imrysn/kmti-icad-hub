# Isolated local configuration for the codex/lms-access-foundation branch.
# This database and port must not be shared with the KMTI desktop application.
ENVIRONMENT=development
APPLICATION_PROFILE=lms
ENFORCE_LMS_DATABASE_ISOLATION=true
USE_MYSQL=false
SQLITE_DB_PATH=backend/kmti_lms_dev.db
SERVER_PORT=3002
FRONTEND_URL=http://127.0.0.1:5173
PUBLIC_APP_URL=http://127.0.0.1:5173
EMAIL_DELIVERY_MODE=outbox
SECRET_KEY=lms-development-only-secret-change-before-deployment
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CAPTCHA_ENABLED=false
CAPTCHA_VERIFY_URL=
CAPTCHA_SECRET=
